-- ══════════════════════════════════════════
-- ★ PANIC KEY SYSTEM
-- ══════════════════════════════════════════
UIS.InputBegan:Connect(function(input,gp)
	if gp then return end
	local keyName=input.KeyCode.Name
	if #keyName==1 and keyName==settings.panicKey then
		-- hide all GUI
		pn.Visible=false; specPanel.Visible=false; distLabel.Visible=false
		notify("⚠ PANIC","GUI hidden — click ✦ SPAWNER to reopen",3)
		-- disconnect every loop
		for _,conn in pairs({
			upConn, ncConn, arConn, fzConn, killConn, igConn, osConn,
			flingConn, chfConn, kotConn,
			abConn, wabConn, ashConn, nrConn, nrlConn, nfeConn,
			hbxConn, afConn, apConn, ablConn, adtConn, aflingConn,
			rbConn2, wowConn, wowlConn, mirConn, folConn, sfConn2,
			pdConn, flingConn2,
			acConns.void, acConns.rag, acConns.afk, acConns.spd, acConns.ban,
			trConn,
		})do pcall(function() if conn then conn:Disconnect() end end) end
		-- clear drawings
		for _,l in pairs(lines)do pcall(function() l:Remove() end) end lines={}
		-- reset all toggle states
		fst=false; ijt=false; sst=false; ust=false; est=false; nst=false
		art=false; fzt=false; pdist=false; klt=false; igt=false; ost=false
		flt=false; chflt=false; kotT=false
		abt=false; wabt=false; asht=false; nrt=false; nrlt=false; nfet=false
		hbxt=false; aft=false; apt=false; ablt=false; adth=false; aflt=false
		rbt=false; wowt=false; wowlt=false; mirt=false; folt=false; sft2=false
		flinging=false; trt=false; nvt=false; cht=false
	end
end)

-- startup toast
task.wait(1)
notify("✦ SPAWNER GUI","Loaded! Panic key: ["..settings.panicKey.."]",4)
