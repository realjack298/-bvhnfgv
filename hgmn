local function fadein(frame,dur)
	frame.BackgroundTransparency=1
	local tweeninfo=TweenInfo.new(dur or 0.35,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
	TS:Create(frame,tweeninfo,{BackgroundTransparency=0}):Play()
	for _,v in pairs(frame:GetDescendants())do
		if v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then
			local ot=v.TextTransparency; v.TextTransparency=1
			TS:Create(v,tweeninfo,{TextTransparency=ot}):Play()
		end
		if v:IsA("Frame") or v:IsA("ScrollingFrame") then
			local ot=v.BackgroundTransparency; if ot<1 then v.BackgroundTransparency=1; TS:Create(v,tweeninfo,{BackgroundTransparency=ot}):Play() end
		end
		if v:IsA("ImageLabel") then
			local ot=v.ImageTransparency; v.ImageTransparency=1; TS:Create(v,tweeninfo,{ImageTransparency=ot}):Play()
		end
	end
end

