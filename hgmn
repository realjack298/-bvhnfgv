	for _,n in pairs(notifStack)do if n and n.Parent then offset=offset+56 end end
	local nf=mk("Frame",g,{Size=UDim2.new(0,230,0,52),Position=UDim2.new(1,10,1,-(60+offset)),BackgroundColor3=Color3.fromRGB(28,28,42),ZIndex=100})
