-- HELPERS
local function hasFF(pl) if not pl.Character then return true end for _,v in pairs(pl.Character:GetDescendants())do if v:IsA("ForceField")then return true end end return false end
local function sameTeam(pl) return pl.Team and p.Team and pl.Team==p.Team end
local function wallBetween(a,b)
	if not settings.wallCheck then return false end
	local dir=(b-a); local ray=workspace:Raycast(a,dir,RaycastParams.new())
	return ray and ray.Instance and not ray.Instance:IsDescendantOf(workspace:FindFirstChild(game.Players:GetPlayerFromCharacter(ray.Instance.Parent) and game.Players:GetPlayerFromCharacter(ray.Instance.Parent).Name or "") or Instance.new("Folder"))
end
local function getTarget()
	for _,pl in pairs(game.Players:GetPlayers())do
		if pl~=p and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") and pl.Character:FindFirstChildOfClass("Humanoid") and pl.Character:FindFirstChildOfClass("Humanoid").Health>0 and not hasFF(pl) then
			if settings.teamCheck and sameTeam(pl) then continue end
			local myHRP=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if myHRP and wallBetween(myHRP.Position,pl.Character.HumanoidRootPart.Position) then continue end
			return pl
		end
	end
end
local hm=function() return p.Character and p.Character:FindFirstChildOfClass("Humanoid") end

