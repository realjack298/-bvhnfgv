	TS:Create(nf,TweenInfo.new(0.3,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=UDim2.new(1,-240,1,-(60+offset))}):Play()
	task.delay(dur,function()
		TS:Create(nf,TweenInfo.new(0.25),{Position=UDim2.new(1,10,1,-(60+offset))}):Play()
